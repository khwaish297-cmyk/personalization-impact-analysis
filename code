# 5. Simple charts ------------------------------------------------------------
make_charts <- function() {
  pdf(file.path(output_dir, "personalization_charts.pdf"), width = 10, height = 6)
  on.exit(dev.off())
  par(mar = c(6, 5, 4, 2))
  rates <- rbind(purchase_results$control_rate_pct,
                 purchase_results$personalized_rate_pct)
  barplot(rates, beside = TRUE, names.arg = segment_names,
          col = c("#BFC7D5", "#245C48"), ylim = c(0, max(rates) * 1.3),
          main = "Purchase rates by customer segment", ylab = "Customers purchasing (%)",
          legend.text = c("Generic", "Personalized"),
          args.legend = list(x = "topleft", bty = "n"))
  for (v in c("totitem", "toteuro")) {
    rows <- order_results[order_results$outcome == v, ]
    values <- rbind(rows$control_mean, rows$personalized_mean)
    barplot(values, beside = TRUE, names.arg = segment_names,
            col = c("#BFC7D5", "#245C48"), ylim = c(0, max(values) * 1.3),
            main = if (v == "totitem") "Average items among buyers" else "Average euros among buyers",
            ylab = if (v == "totitem") "Items per buyer" else "Euros per buyer",
            legend.text = c("Generic", "Personalized"),
            args.legend = list(x = "topleft", bty = "n"))
  }
  boxplot(log(toteuro) ~ interaction(tx, segment), data = buyers,
          las = 2, col = "#A7C8B8", main = "Order value distribution among buyers",
          ylab = "Natural log of euros", xlab = "")
}
make_charts()
